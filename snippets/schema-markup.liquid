{%- comment -%}
  schema-markup.liquid — PetWorld SEO Schema (JSON-LD)

  Ergänzt die von Shopify auto-generierten Schemas um:
  - Enriched Organization (description, sameAs, contactPoint, address)
  - WebSite mit SearchAction (Sitelinks-Searchbox)
  - BreadcrumbList für Collection/Product/Article
  - BlogPosting für Artikel

  Product Schema wird explizit mitgeliefert (sauberes Product mit aggregateRating,
  brand=PetWorld, offers, focus_keyword als keywords). Shopify's ProductGroup
  bleibt zusätzlich bestehen — Google dedupliziert über @id.
{%- endcomment -%}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": "{{ shop.url }}#organization",
  "name": "PetWorld",
  "url": "{{ shop.url }}",
  "logo": "{{ shop.url }}/cdn/shop/files/logo_name_weiss.png",
  "description": "Personalisierte Poster und Geschenke für Hunde, Katzen und andere Haustiere. Nachhaltig produziert in Europa.",
  "email": "bestellungen@pet-world.at",
  "address": {
    "@type": "PostalAddress",
    "addressCountry": "AT"
  },
  "contactPoint": {
    "@type": "ContactPoint",
    "contactType": "customer service",
    "email": "bestellungen@pet-world.at",
    "availableLanguage": ["German", "English"]
  },
  "sameAs": [
    {%- if settings.social_instagram_link != blank -%}"{{ settings.social_instagram_link }}"{%- endif -%}
    {%- if settings.social_instagram_link != blank and settings.social_facebook_link != blank -%},{%- endif -%}
    {%- if settings.social_facebook_link != blank -%}"{{ settings.social_facebook_link }}"{%- endif -%}
  ]
}
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": "{{ shop.url }}#website",
  "url": "{{ shop.url }}",
  "name": "PetWorld",
  "inLanguage": "de-AT",
  "publisher": { "@id": "{{ shop.url }}#organization" },
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": "{{ shop.url }}/search?q={search_term_string}"
    },
    "query-input": "required name=search_term_string"
  }
}
</script>

{%- if request.page_type == 'collection' and collection -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Start",
      "item": "{{ shop.url }}"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": {{ collection.title | json }},
      "item": "{{ shop.url }}{{ collection.url }}"
    }
  ]
}
</script>
{%- endif -%}

{%- if request.page_type == 'product' and product -%}
  {%- assign bc_collection = product.collections.first -%}
  {%- assign focus_kw = product.metafields.seo.focus_keyword | default: '' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "@id": "{{ shop.url }}{{ product.url }}#product",
  "name": {{ product.title | json }},
  "description": {{ product.description | strip_html | truncate: 500 | json }},
  "image": [
    {%- for img in product.images limit: 5 -%}
      "https:{{ img | image_url: width: 1200 }}"{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ],
  "sku": {{ product.selected_or_first_available_variant.sku | json }},
  "brand": {
    "@type": "Brand",
    "name": "PetWorld"
  },
  "url": "{{ shop.url }}{{ product.url }}",
  {%- if focus_kw != blank -%}
  "keywords": {{ focus_kw | json }},
  {%- endif -%}
  "offers": {
    "@type": "Offer",
    "url": "{{ shop.url }}{{ product.url }}",
    "priceCurrency": "{{ cart.currency.iso_code }}",
    "price": "{{ product.price | money_without_currency | replace: ',', '.' | strip_html }}",
    "availability": "{% if product.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}",
    "itemCondition": "https://schema.org/NewCondition"
  }
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Start",
      "item": "{{ shop.url }}"
    }
    {%- if bc_collection -%}
    ,{
      "@type": "ListItem",
      "position": 2,
      "name": {{ bc_collection.title | json }},
      "item": "{{ shop.url }}{{ bc_collection.url }}"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": {{ product.title | json }},
      "item": "{{ shop.url }}{{ product.url }}"
    }
    {%- else -%}
    ,{
      "@type": "ListItem",
      "position": 2,
      "name": {{ product.title | json }},
      "item": "{{ shop.url }}{{ product.url }}"
    }
    {%- endif -%}
  ]
}
</script>
{%- endif -%}

{%- if request.page_type == 'article' and article -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": {{ article.title | json }},
  "image": "{{ article.image | image_url: width: 1200 }}",
  "datePublished": "{{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' }}",
  "dateModified": "{{ article.updated_at | date: '%Y-%m-%dT%H:%M:%S%z' }}",
  "author": {
    "@type": "Person",
    "name": {{ article.author | json }}
  },
  "publisher": { "@id": "{{ shop.url }}#organization" },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": "{{ shop.url }}{{ article.url }}"
  }
}
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Start",
      "item": "{{ shop.url }}"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": {{ blog.title | json }},
      "item": "{{ shop.url }}{{ blog.url }}"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": {{ article.title | json }},
      "item": "{{ shop.url }}{{ article.url }}"
    }
  ]
}
</script>
{%- endif -%}
