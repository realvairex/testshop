er zu gewährleisten, empfehlen wir folgende Pflegehinweise:<\/p><p><br\/><strong>• <\/strong>Regelmäßig mit einem weichen, trockenen Mikrofasertuch entstauben.<br\/><strong>• <\/strong>Bei Fingerabdrücken oder Verschmutzungen vorsichtig mit einem feuchten Tuch und einer milden Seifenlösung abwischen.<br\/><strong>• <\/strong>Keine scheuernden Reinigungsmittel oder aggressive Chemikalien verwenden, da diese den Druck beschädigen können.<br\/><strong>• <\/strong>Vorsichtig handhaben, um Knicken oder Verbiegen zu vermeiden.<\/p>","width":"100%","max_width":"normal","alignment":"left","type_preset":"rte","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"var(--color-foreground)","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}}},"block_order":["text_hnVc3z"]}},"block_order":["accordion_row_CnQdKm","accordion_row_EjPgQj"]}},"block_order":["group_czKG4R","product_title_46Kiht","buy_buttons_NmYpFG","payment_icons_VJTjti","accordion_PeywHC"]}},"custom_css":[],"settings":{"content_width":"content-center-aligned","desktop_media_position":"left","equal_columns":true,"limit_details_width":false,"gap":0,"color_scheme":"scheme-644163f8-ee83-4a49-a32e-a2b459e8a96a","padding-block-start":0,"padding-block-end":48}},"section_TMFJjg":{"type":"section","disabled":true,"name":"t:names.custom_section","settings":{"content_direction":"column","vertical_on_mobile":true,"horizontal_alignment":"flex-start","vertical_alignment":"center","align_baseline":false,"horizontal_alignment_flex_direction_column":"flex-start","vertical_alignment_flex_direction_column":"center","gap":0,"section_width":"page-width","section_height":"custom","section_height_custom":2,"color_scheme":"scheme-7e76d070-642f-4b91-91c1-b5364c47dceb","background_media":"none","video_position":"cover","background_imag