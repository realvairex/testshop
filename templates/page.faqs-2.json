dding-block-start":10,"padding-block-end":10,"padding-inline-start":20,"padding-inline-end":20},"blocks":{"accordion_row_mffWWU":{"type":"_accordion-row","settings":{"heading":"Wie lade ich mein Foto hoch?","open_by_default":false,"icon":"none","width":20},"blocks":{"text_aF4mgi":{"type":"text","settings":{"text":"<p>Ganz einfach im Bestellprozess: Foto auswählen, hochladen, und fertig!<\/p>","width":"100%","max_width":"none","alignment":"left","type_preset":"rte","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"var(--color-foreground)","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}}},"block_order":["text_aF4mgi"]},"accordion_row_yNGxdH":{"type":"_accordion-row","settings":{"heading":"Welche Fotoqualität brauche ich?","open_by_default":false,"icon":"none","width":20},"blocks":{"text_ijiAgw":{"type":"text","settings":{"text":"<p>Damit dein Haustierposter richtig gut aussieht, ist ein hochwertiges Foto entscheidend. <\/p><p>Achte deshalb auf folgende Punkte:<\/p><ul><li><strong>Licht: <\/strong>Mach das Foto bei Tageslicht oder in einem gut beleuchteten Raum.<\/li><li><strong>Kamera:<\/strong> Verwende ein Smartphone mit guter Kamera oder eine Digitalkamera – bitte keine Screenshots oder WhatsApp-Bilder.<\/li><li><strong>Position:<\/strong> Das Gesicht und der Hals deines Haustiers sollten gut sichtbar und scharf sein – ohne Schatten.<\/li><li><strong>Perspektive: <\/strong>Fotografiere dein Tier möglichst frontal und auf Augenhöhe.<\/li><li><strong>Filter:<\/strong> Bitte keine stark bearbeiteten oder gefilterten Fotos – das verfälscht das Ergebnis.<\/li><\/ul><p>Das Foto sollte mindestens <strong>2 MB groß<\/strong> sein, damit es sich gut für den Druck eignet. Je besser die Bildqualität, desto schöner wird dein Poster!<\/p>","width":"100%","max_width":"none","alignment":"left","type_preset":"rte","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"var(--color-foreground)","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}}},"block_order":["text_ijiAgw"]},"accordion_row_ze4aLB":{"type":"_accordion-row","name":"t:names.accordion_row","settings":{"heading":"Kann ich meine Bestellung nachträglich ändern?","open_by_default":false,"icon":"none","width":20},"blocks":{"text_C3Bj9r":{"type":"text","name":"t:names.text","settings":{"text":"<p>Sobald deine Bestellung bearbeitet wurde, können <strong>keine Änderungen <\/strong>mehr vorgenommen werden. <br\/>Wir empfehlen, vor dem Abschicken der Bestellung alle Details zu überprüfen.<\/p>","width":"100%","max_width":"none","alignment":"left","type_preset":"rte","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"var(--color-foreground)","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}}},"block_order":["text_C3Bj9r"]},"accordion_row_LijNyH":{"type":"_accordion-row","name":"t:names.accordion_row","settings":{"heading":"Welche Zahlungsmethoden werden akzeptiert?","open_by_default":false,"icon":"none","width":20},"blocks":{"text_mUr63Q":{"type":"text","name":"t:names.text","settings":{"text":"<p>Wir akzeptieren derzeit folgende Zahlungsmethoden:<\/p><ul><li>VISA<\/li><li>Mastercard<\/li><li>American Express (AMEX)<\/li><li>Apple Pay<\/li><li>EPS (Electronic Standard Payment)<\/li><li>Google Pay<\/li><li>Klarna<\/li><li>Maestro<\/li><li>Shop Pay<\/li><li>Union Pay<\/li><\/ul>","width":"100%","max_width":"none","alignment":"left","type_preset":"rte","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"var(--color-foreground)","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}}},"block_order":["text_mUr63Q"]},"accordion_row_HFfigM":{"type":"_accordion-row","name":"t:names.accordion_row","settings":{"heading":"Kann ich in mehreren Raten bezahlen?","open_by_default":false,"icon":"none","width":20},"blocks":{"text_V8nYQJ":{"type":"text","name":"t:names.text","settings":{"text":"<p>Ja, du kannst die <strong>Ratenzahlung<\/strong> über Klarna nutzen, um deinen Einkauf bequem in mehreren monatlichen Zahlungen zu begleichen.<\/p>","width":"100%","max_width":"none","alignment":"left","type_preset":"rte","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"var(--color-foreground)","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}}},"block_order":["text_V8nYQJ"]}},"block_order":["accordion_row_mffWWU","accordion_row_yNGxdH","accordion_row_ze4aLB","accordion_row_LijNyH","accordion_row_HFfigM"]}},"block_order":["text_MYT9GC","accordion_8KFHNw"]},"group_Yw6gTC":{"type":"group","name":"Versand","settings":{"content_direction":"column","vertical_on_mobile":true,"horizontal_alignment":"flex-start","vertical_alignment":"center","align_baseline":false,"horizontal_alignment_flex_direction_column":"flex-start","vertical_alignment_flex_direction_column":"center","gap":12,"width":"fill","custom_width":100,"width_mobile":"fill","custom_width_mobile":100,"height":"fit","custom_height":100,"inherit_color_scheme":true,"color_scheme":"","background_media":"none","video_position":"cover","background_image_position":"cover","border":"none","border_width":1,"border_opacity":100,"border_radius":0,"toggle_overlay":false,"overlay_color":"#00000026","overlay_style":"solid","gradient_direction":"to top","link":"","open_in_new_tab":false,"placeholder":"","padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{"text_rhnCdD":{"type":"text","name":"t:names.heading","settings":{"text":"<p>Versand & Retouren<\/p>","width":"100%","max_width":"narrow","alignment":"center","type_preset":"custom","font":"var(--font-heading--family)","font_size":"1.5rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"var(--color-foreground-heading)","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}},"accordion_Qrw63w":{"type":"accordion","name":"t:names.accordion","settings":{"icon":"caret","dividers":true,"type_preset":"h6","inherit_color_scheme":false,"color_scheme":"scheme-9fc3d33a-6981-4169-81c3-6644cb4d864c","border":"none","border_width":1,"border_opacity":100,"border_radius":20,"padding-block-start":10,"padding-block-end":10,"padding-inline-start":20,"padding-inline-end":20},"blocks":{"accordion_row_QAb7by":{"type":"_accordion-row","settings":{"heading":"Wo ist meine Bestellung?","open_by_default":false,"icon":"none","width":20},"blocks":{"text_fDXhFe":{"type":"text","settings":{"text":"<p>Alle Bestellungen, die versendet wurden, erhalten einen <strong>Tracking-Link<\/strong>, mit dem du den Status deiner Bestellung jederzeit verfolgen kannst. <br\/><br\/>Du findest diesen Link in der <strong>Versandbestätigungsmail<\/strong>.<\/p>","width":"100%","max_width":"none","alignment":"left","type_preset":"rte","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"var(--color-foreground)","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}}},"block_order":["text_fDXhFe"]},"accordion_row_Kpm4Li":{"type":"_accordion-row","settings":{"heading":"Wie lange dauert der Versand?","open_by_default":false,"icon":"none","width":20},"blocks":{"text_87yGVq":{"type":"text","settings":{"text":"<p>In der Regel kommt deine Bestellung innerhalb von 3–7 Werktagen bei dir an.<\/p>","width":"100%","max_width":"none","alignment":"left","type_preset":"rte","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"var(--color-foreground)","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}}},"block_order":["text_87yGVq"]},"accordion_row_MLwhQj":{"type":"_accordion-row","name":"t:names.accordion_row","settings":{"heading":"Kommen alle Produkte in einer Lieferung?","open_by_default":false,"icon":"none","width":20},"blocks":{"text_34KR7J":{"type":"text","name":"t:names.text","settings":{"text":"<p>Wir setzen alles daran, dass alle Produkte deiner Bestellung zusammen geliefert werden. In manchen Fällen ist dies jedoch aufgrund der Art der Produkte nicht immer möglich.<br\/><br\/>Poster und Rahmen werden jedoch immer gemeinsam versendet. Dein Portrait wird bereits eingerahmt bei dir ankommen.<\/p>","width":"100%","max_width":"none","alignment":"left","type_preset":"rte","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"var(--color-foreground)","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}}},"block_order":["text_34KR7J"]},"accordion_row_LHYCCP":{"type":"_accordion-row","name":"t:names.accordion_row","settings":{"heading":"Kann ich personalisierte Produkte zurückgeben?","open_by_default":false,"icon":"none","width":20},"blocks":{"text_Hy6pre":{"type":"text","name":"t:names.text","settings":{"text":"<p>Bei einigen Produkten besteht kein gesetzliches Widerrufsrecht. <br\/><strong>Gemäß § 18 Abs. 1 Ziffer 3 des Fern- und Auswärtsgeschäfte-Gesetzes (FAGG)<\/strong> sind <strong>individuell angefertigte Waren<\/strong> vom Widerrufsrecht ausgeschlossen. Dies bedeutet, dass Produkte, die speziell nach Ihren Wünschen angefertigt oder eindeutig auf Ihre persönlichen Bedürfnisse zugeschnitten sind, nicht widerrufen werden können.<\/p>","width":"100%","max_width":"none","alignment":"left","type_preset":"rte","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"var(--color-foreground)","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}}},"block_order":["text_Hy6pre"]},"accordion_row_zm39GP":{"type":"_accordion-row","name":"t:names.accordion_row","settings":{"heading":"Was tun bei einer beschädigten Lieferung?","open_by_default":false,"icon":"none","width":20},"blocks":{"text_cjn3kM":{"type":"text","name":"t:names.text","settings":{"text":"<p>Falls deine Bestellung beschädigt bei dir ankommt, melde dich bitte innerhalb von 7 Tagen bei unserem Kundenservice. Wir kümmern uns um den Austausch des beschädigten Produkts oder eine andere Lösung.<\/p>","width":"100%","max_width":"none","alignment":"left","type_preset":"rte","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"var(--color-foreground)","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}}},"block_order":["text_cjn3kM"]}},"block_order":["accordion_row_QAb7by","accordion_row_Kpm4Li","accordion_row_MLwhQj","accordion_row_LHYCCP","accordion_row_zm39GP"]}},"block_order":["text_rhnCdD","accordion_Qrw63w"]},"group_LDJTAC":{"type":"group","name":"Produkt","settings":{"content_direction":"column","vertical_on_mobile":true,"horizontal_alignment":"flex-start","vertical_alignment":"center","align_baseline":false,"horizontal_alignment_flex_direction_column":"flex-start","vertical_alignment_flex_direction_column":"center","gap":12,"width":"fill","custom_width":100,"width_mobile":"fill","custom_width_mobile":100,"height":"fit","custom_height":100,"inherit_color_scheme":true,"color_scheme":"","background_media":"none","video_position":"cover","background_image_position":"cover","border":"none","border_width":1,"border_opacity":100,"border_radius":0,"toggle_overlay":false,"overlay_color":"#00000026","overlay_style":"solid","gradient_direction":"to top","link":"","open_in_new_tab":false,"placeholder":"","padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{"text_VQNERa":{"type":"text","name":"t:names.heading","settings":{"text":"<p>Produkt<\/p>","width":"100%","max_width":"narrow","alignment":"center","type_preset":"custom","font":"var(--font-heading--family)","font_size":"1.5rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"var(--color-foreground-heading)","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}},"accordion_Qtqrxk":{"type":"accordion","name":"t:names.accordion","settings":{"icon":"caret","dividers":true,"type_preset":"h6","inherit_color_scheme":false,"color_scheme":"scheme-9fc3d33a-6981-4169-81c3-6644cb4d864c","border":"none","border_width":1,"border_opacity":100,"border_radius":20,"padding-block-start":10,"padding-block-end":10,"padding-inline-start":20,"padding-inline-end":20},"blocks":{"accordion_row_dAm6Rr":{"type":"_accordion-row","settings":{"heading":"Werden die Produkte nachhaltig produziert?","open_by_default":false,"icon":"none","width":20},"blocks":{"text_3TXx9H":{"type":"text","settings":{"text":"<p><strong>Ja<\/strong>, alle Produkte werden nachhaltig produziert. Unsere Produktionspartner setzen auf erneuerbare Energiequellen in ihren Produktionsstätten, nutzen über 1 Million Kilogramm recyceltes Plastik und stellen sicher, dass 97 % des verwendeten Holzes aus FSC-zertifizierten Wäldern stammt. <br\/><br\/>Diese Maßnahmen unterstützen ihre Bemühungen um umweltfreundliche und verantwortungsbewusste Produktion.<\/p>","width":"100%","max_width":"none","alignment":"left","type_preset":"rte","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"var(--color-foreground)","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}}},"block_order":["text_3TXx9H"]},"accordion_row_caVDM4":{"type":"_accordion-row","settings":{"heading":"Sind die Produkte schadstofffrei?","open_by_default":false,"icon":"none","width":20},"blocks":{"text_EtUGVQ":{"type":"text","settings":{"text":"<p>Ja, alle unsere Produkte werden unter strengen <strong>Sicherheits- und Qualitätsstandards<\/strong> hergestellt. Wir stellen sicher, dass alle Materialien <strong>frei von schädlichen Chemikalien<\/strong> sind und keine Gefahr für die Gesundheit darstellen. Unsere Produktionspartner achten auf <strong>zertifizierte Materialien<\/strong>, die die geltenden <strong>EU-Vorgaben <\/strong>erfüllen.<\/p>","width":"100%","max_width":"none","alignment":"left","type_preset":"rte","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"var(--color-foreground)","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}}},"block_order":["text_EtUGVQ"]},"accordion_row_TjqVBT":{"type":"_accordion-row","name":"t:names.accordion_row","settings":{"heading":"Wie stellt ihr die Qualität der Poster sicher?","open_by_default":false,"icon":"none","width":20},"blocks":{"text_YMMTee":{"type":"text","name":"t:names.text","settings":{"text":"<p>Wir arbeiten ausschließlich mit erfahrenen Druckpartnern zusammen, die den gesamten Herstellungsprozess – von den Materialien bis zum fertigen Produkt – kontrollieren, um höchste Qualitätsstandards zu gewährleisten.<\/p>","width":"100%","max_width":"none","alignment":"left","type_preset":"rte","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"var(--color-foreground)","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}}},"block_order":["text_YMMTee"]},"accordion_row_tfyKfT":{"type":"_accordion-row","name":"t:names.accordion_row","settings":{"heading":"Wie pflege und lagere ich mein Poster richtig?","open_by_default":false,"icon":"none","width":20},"blocks":{"text_YUqxxH":{"type":"text","name":"t:names.text","settings":{"text":"<p>Um die Qualität deines Posters möglichst lange zu erhalten, empfehlen wir, es an einem trockenen Ort ohne direkte Sonneneinstrahlung aufzuhängen oder zu lagern. Sollte das Poster leicht verschmutzen, wische es vorsichtig mit einem trockenen, weichen Tuch ab.<br\/> Bitte vermeide scharfe Reinigungsmittel oder übermäßige Feuchtigkeit, um Beschädigungen zu verhindern.<\/p>","width":"100%","max_width":"none","alignment":"left","type_preset":"rte","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"var(--color-foreground)","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}}},"block_order":["text_YUqxxH"]},"accordion_row_V3NbgX":{"type":"_accordion-row","name":"t:names.accordion_row","settings":{"heading":"In welchen Formaten sind eure Poster erhältlich?","open_by_default":false,"icon":"none","width":20},"blocks":{"text_hNVEk4":{"type":"text","name":"t:names.text","settings":{"text":"<p>Unsere Poster bieten wir in verschiedenen Größen an, damit du das für dich passende Format auswählen kannst. Von kleineren Postern für den Schreibtisch bis zu großformatigen Postern für die Wandgestaltung ist alles dabei. Genaue Informationen zu den verfügbaren Formaten findest du jeweils auf der jeweiligen Produktseite.<\/p>","width":"100%","max_width":"none","alignment":"left","type_preset":"rte","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"var(--color-foreground)","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}}},"block_order":["text_hNVEk4"]}},"block_order":["accordion_row_dAm6Rr","accordion_row_caVDM4","accordion_row_TjqVBT","accordion_row_tfyKfT","accordion_row_V3NbgX"]}},"block_order":["text_VQNERa","accordion_Qtqrxk"]}},"block_order":["group_3YXpf9","group_Yw6gTC","group_LDJTAC"]}},"block_order":["text_6ydyYQ","text_iaC9Qt","group_kJWBGf"],"custom_css":[".details-content {color: #f5f5f5 !important;}"],"name":"t:names.custom_section","settings":{"content_direction":"column","vertical_on_mobile":true,"horizontal_alignment":"flex-start","vertical_alignment":"center","align_baseline":false,"horizontal_alignment_flex_direction_column":"center","vertical_alignment_flex_direction_column":"center","gap":0,"section_width":"page-width","section_height":"small","section_height_custom":50,"color_scheme":"scheme-7e76d070-642f-4b91-91c1-b5364c47dceb","background_media":"none","video_position":"cover","background_image_position":"cover","border":"none","border_width":1,"border_opacity":100,"border_radius":0,"toggle_overlay":false,"overlay_color":"#00000026","overlay_style":"solid","gradient_direction":"to top","padding-block-start":48,"padding-block-end":48}}},"order":["main","section_TygNQ9"]}